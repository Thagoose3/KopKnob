<Window x:Class="Knob.App.Shell.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Knob.App.Shell"
        Title="Knob"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="720" Height="280"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource ForegroundBrush}">
    <!--
      The window is always panel-sized; only Surface changes size/position inside it (pill ↔ panel).
      Fully transparent pixels are click-through. Surface is placed with Margin from the top-left,
      computed per dock edge in code.
    -->
    <Grid>
        <Border x:Name="Surface"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="150" Height="30"
                CornerRadius="0,0,12,12"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0"
                ClipToBounds="True">
            <Grid x:Name="SurfaceGrid">
                <!-- Scroll theme: the red silk body (drawn instead of the plain background) -->
                <Border x:Name="ScrollBody" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="2" BorderThickness="1" />
                <!-- Glass theme: soft light sheen across the top of the glass -->
                <Border x:Name="GlassSheen" Visibility="Collapsed" IsHitTestVisible="False" />

                <Grid x:Name="PillContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="PillNormal" Orientation="Horizontal">
                        <Ellipse x:Name="CoffeeDot" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        <TextBlock x:Name="TimeText" Text="--:--" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TimerText" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        <TextBlock x:Name="BatteryText" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubtleForegroundBrush}" Visibility="Collapsed" />
                    </StackPanel>
                    <!-- Short status that temporarily replaces the normal pill ("Reading…", "Copied 42 chars") -->
                    <TextBlock x:Name="MessageText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Visibility="Collapsed" />
                </Grid>

                <!-- Floating mode only: grip + close (✕ docks it back to its last edge) -->
                <Grid x:Name="FloatBar" Height="20" VerticalAlignment="Top" Visibility="Collapsed">
                    <Border Width="36" Height="4" CornerRadius="2" Background="{StaticResource DimForegroundBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Button x:Name="FloatClose" Style="{StaticResource GhostButton}" Width="22" Height="18"
                            HorizontalAlignment="Right" Margin="0,2,6,0" ToolTip="Dock back (Esc)">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" />
                    </Button>
                </Grid>

                <Grid x:Name="PanelContent" Opacity="0" Visibility="Collapsed" Margin="12,10,12,12">
                    <!-- Scroll theme: cream paper with a gold rule and a faded Monkey King painting; reaches out past the content padding -->
                    <Border x:Name="ScrollPaper" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="1.2" CornerRadius="1">
                        <Grid ClipToBounds="True">
                            <local:WukongArt x:Name="ScrollArt" Opacity="0.30" />
                        </Grid>
                    </Border>
                    <ContentPresenter x:Name="PanelHost" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
