<UserControl x:Class="Knob.App.Shell.WukongArt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!--
      Background ornament for the "Sutra scroll" theme (Journey to the West motifs, no figure): the golden-banded
      staff with a gourd hanging from it, over golden clouds. Drawn on a 720×280 canvas and stretched to the panel.
      The host sets the opacity so it reads like a faded painting on the paper.
    -->
    <UserControl.Resources>
        <LinearGradientBrush x:Key="GoldH" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#A86F12" />
            <GradientStop Offset="0.5" Color="#FFE27A" />
            <GradientStop Offset="1" Color="#A86F12" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Staff" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Offset="0" Color="#6E1410" />
            <GradientStop Offset="0.5" Color="#D0362B" />
            <GradientStop Offset="1" Color="#6E1410" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="Gourd" GradientOrigin="0.35,0.3" Center="0.4,0.4" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Offset="0" Color="#FFE08A" />
            <GradientStop Offset="0.5" Color="#D99A2B" />
            <GradientStop Offset="1" Color="#6E4210" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="Cloud" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFF1B0" />
            <GradientStop Offset="0.5" Color="#F2BF3A" />
            <GradientStop Offset="1" Color="#B9801A" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Viewbox Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Canvas Width="720" Height="280" ClipToBounds="True">

            <!-- staff, leaning across the right side, with gold bands at both ends -->
            <Line X1="470" Y1="300" X2="690" Y2="10" Stroke="{StaticResource Staff}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="470" Y1="300" X2="482" Y2="284" Stroke="{StaticResource GoldH}" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="678" Y1="26" X2="690" Y2="10" Stroke="{StaticResource GoldH}" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

            <!-- gourd hanging from the staff on a red cord -->
            <Path Data="M591 140 C594 146 598 150 600 158" Stroke="#C8382E" StrokeThickness="2.5" StrokeStartLineCap="Round" />
            <Rectangle Canvas.Left="596" Canvas.Top="156" Width="8" Height="9" RadiusX="2" RadiusY="2" Fill="#4A2A10" />
            <Ellipse Canvas.Left="585" Canvas.Top="164" Width="30" Height="36" Fill="{StaticResource Gourd}" />
            <Ellipse Canvas.Left="574" Canvas.Top="194" Width="52" Height="58" Fill="{StaticResource Gourd}" />
            <Rectangle Canvas.Left="585" Canvas.Top="195" Width="30" Height="6" RadiusX="3" RadiusY="3" Fill="#C8382E" />
            <Path Data="M614 199 l5 26 M617 198 l9 22 M611 200 l1 28" Stroke="#C8382E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

            <!-- golden clouds along the bottom of the scroll -->
            <Canvas>
                <Ellipse Canvas.Left="400" Canvas.Top="226" Width="70" Height="70" Fill="{StaticResource Cloud}" Stroke="#9A6A10" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="452" Canvas.Top="240" Width="54" Height="54" Fill="{StaticResource Cloud}" Stroke="#9A6A10" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="372" Canvas.Top="248" Width="44" Height="44" Fill="{StaticResource Cloud}" Stroke="#9A6A10" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="640" Canvas.Top="232" Width="66" Height="66" Fill="{StaticResource Cloud}" Stroke="#9A6A10" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="604" Canvas.Top="250" Width="46" Height="46" Fill="{StaticResource Cloud}" Stroke="#9A6A10" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="690" Canvas.Top="252" Width="40" Height="40" Fill="{StaticResource Cloud}" Stroke="#9A6A10" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="20" Canvas.Top="246" Width="56" Height="56" Fill="{StaticResource Cloud}" Stroke="#9A6A10" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="64" Canvas.Top="256" Width="40" Height="40" Fill="{StaticResource Cloud}" Stroke="#9A6A10" StrokeThickness="1.5" />
                <Path Data="M435 261 m-14 0 a14 14 0 1 1 14 14 a7 7 0 1 1 -7 -7 M673 265 m12 0 a12 12 0 1 0 -12 12 a6 6 0 1 0 6 -6 M48 274 m-10 0 a10 10 0 1 1 10 10"
                      Stroke="#9A6A10" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M330 236 C360 222 388 236 410 226 M520 250 C560 232 590 246 620 236 M110 262 C140 248 170 262 196 252"
                      Stroke="#E8B33A" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
