<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      "Scroll" theme (Journey to the West sutra scroll): lacquer-red silk, aged-paper text, gold accents.
      Merged after Dark.xaml at startup, so these keys win.
    -->
    <Color x:Key="AccentColor">#E0A92E</Color>
    <Color x:Key="BackgroundColor">#FF2B1210</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#E0A92E" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF2B1210" />
    <SolidColorBrush x:Key="TileBrush" Color="#3A1A17" />
    <SolidColorBrush x:Key="ControlBrush" Color="#4D2420" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#5E2E27" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F6EBD9" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#CBAA88" />
    <SolidColorBrush x:Key="DimForegroundBrush" Color="#8E6B55" />

    <!-- Scroll-only pieces -->
    <SolidColorBrush x:Key="ScrollTrimBrush" Color="#B88A2A" />
    <LinearGradientBrush x:Key="ScrollRodVertical" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#5A3608" />
        <GradientStop Offset="0.35" Color="#F7D04A" />
        <GradientStop Offset="0.55" Color="#FFF1B0" />
        <GradientStop Offset="1" Color="#7A4A10" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollRodHorizontal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#5A3608" />
        <GradientStop Offset="0.35" Color="#F7D04A" />
        <GradientStop Offset="0.55" Color="#FFF1B0" />
        <GradientStop Offset="1" Color="#7A4A10" />
    </LinearGradientBrush>
</ResourceDictionary>
