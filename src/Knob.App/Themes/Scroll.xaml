<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      "Sutra scroll" theme (Journey to the West): red lacquer silk frame, cream paper inside with ink text,
      gold trim, jade-green accents. Merged after Dark.xaml at startup, so these keys win.
    -->
    <Color x:Key="AccentColor">#2E8B6A</Color>
    <!-- Surface background is transparent in this theme: the red body and the rods are drawn instead. -->
    <Color x:Key="BackgroundColor">#00000000</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#2E8B6A" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFF8E8" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F4E8CC" />
    <!-- Slightly translucent so the painting on the paper shows through cards and buttons -->
    <SolidColorBrush x:Key="TileBrush" Color="#CCEADBB8" />
    <SolidColorBrush x:Key="ControlBrush" Color="#D9E0CDA4" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E6D6BF92" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#2A1A10" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#6E5038" />
    <SolidColorBrush x:Key="DimForegroundBrush" Color="#A88B6C" />

    <!-- Scroll pieces -->
    <SolidColorBrush x:Key="ScrollTrimBrush" Color="#C9962E" />
    <SolidColorBrush x:Key="ScrollPillTextBrush" Color="#FFF3D6" />
    <SolidColorBrush x:Key="ScrollPillSubtleBrush" Color="#F2C9A8" />
    <LinearGradientBrush x:Key="ScrollBodyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#C42A20" />
        <GradientStop Offset="0.5" Color="#A81E17" />
        <GradientStop Offset="1" Color="#7E1410" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollPaperBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FBF3DE" />
        <GradientStop Offset="1" Color="#F1E3C1" />
    </LinearGradientBrush>
</ResourceDictionary>
