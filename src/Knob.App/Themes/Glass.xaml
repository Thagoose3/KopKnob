<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      "Glass" theme: the Dynamic Island shape in frosted dark glass. There is no real blur behind it
      (a layered window can't get one cheaply); a translucent smoky fill, a light hairline edge and a soft
      top sheen give the frosted look. Merged after Dark.xaml at startup, so these keys win.
    -->
    <Color x:Key="AccentColor">#8FA8FF</Color>
    <!-- Smoky, about 72% opaque: the desktop shows through faintly, text stays readable on busy wallpapers -->
    <Color x:Key="BackgroundColor">#B8141419</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#8FA8FF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0E1020" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#B8141419" />
    <!-- Cards and buttons are lighter frosted panes on the glass -->
    <SolidColorBrush x:Key="TileBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F7F7FA" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#B4B4C0" />
    <SolidColorBrush x:Key="DimForegroundBrush" Color="#7A7A88" />

    <!-- Glass pieces -->
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#59FFFFFF" />
        <GradientStop Offset="1" Color="#1AFFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1CFFFFFF" />
        <GradientStop Offset="0.45" Color="#06FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>
</ResourceDictionary>
