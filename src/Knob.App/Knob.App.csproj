<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\knob.ico</ApplicationIcon>
    <AssemblyName>Knob</AssemblyName>
    <RootNamespace>Knob.App</RootNamespace>
    <LangVersion>12</LangVersion>
    <!-- WFAC010: WinForms wants DPI via API; this is a WPF app, PLAN requires PerMonitorV2 in app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- WinForms is only used for NotifyIcon / PowerStatus; keep its namespaces out of global usings to avoid WPF name clashes. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Knob.Core\Knob.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!-- App icon, also embedded so the tray can load it at the right small size -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\knob.ico" LogicalName="Knob.ico" />
  </ItemGroup>

  <!-- OCR language data (tesseract-ocr/tessdata_fast, Apache-2.0), next to the exe -->
  <ItemGroup>
    <None Include="tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
